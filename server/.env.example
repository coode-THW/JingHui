# 默认 SQLite，复制本文件为 .env 即可按需修改
APP_ENV=development
DEBUG=true
SECRET_KEY=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./jinghui.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# demo / tongyi / jiemeng。真实渠道未配置时不要切换，DemoProvider 无需联网。
AI_PROVIDER=demo
AI_REQUEST_TIMEOUT=60

# 通义万相（阿里云百炼）
TONGYI_API_KEY=
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
TONGYI_TASK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/tasks
TONGYI_MODEL=wanx-v1

# 即梦 / 火山引擎兼容 HTTP 网关；网关需接受 Bearer Key 与 OpenAI 风格图片请求
JIEMENG_API_KEY=
JIEMENG_BASE_URL=https://visual.volcengineapi.com
JIEMENG_MODEL=jimeng_vgfm_t2i_lcg
